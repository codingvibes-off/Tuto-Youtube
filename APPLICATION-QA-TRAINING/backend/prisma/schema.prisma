// Voyago - schéma de données (démo pédagogique Coding Vibes)
// SQLite par défaut pour un démarrage local sans dépendance externe.
// Pour PostgreSQL : changer provider = "postgresql" et DATABASE_URL dans .env
// (le schéma est compatible tel quel avec les deux, à l'exception du type Json
// qui reste stocké en texte sur SQLite).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite ne supporte pas les enums natifs Prisma : ces champs sont stockés
// en String et leurs valeurs autorisées sont validées côté application
// ("USER" | "ADMIN", "FLIGHT" | "HOTEL", "CONFIRMED" | "CANCELLED").

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("USER")
  createdAt    DateTime  @default(now())
  cartItems    CartItem[]
  bookings     Booking[]
}

model Destination {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  city        String
  country     String
  imageUrl    String
  description String
  popular     Boolean  @default(false)
  flights     Flight[]
  hotels      Hotel[]
}

model Flight {
  id              Int         @id @default(autoincrement())
  destination     Destination @relation(fields: [destinationId], references: [id])
  destinationId   Int
  airline         String
  departAirport   String
  arriveAirport   String
  departTime      DateTime
  arriveTime      DateTime
  durationMinutes Int
  price           Float
  stops           Int         @default(0)
  imageUrl        String
}

model Hotel {
  id            Int         @id @default(autoincrement())
  destination   Destination @relation(fields: [destinationId], references: [id])
  destinationId Int
  name          String
  stars         Int
  pricePerNight Float
  imageUrl      String
  address       String
  amenities     String // JSON.stringify(string[])
  reviews       Review[]
}

model Review {
  id        Int      @id @default(autoincrement())
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  hotelId   Int
  author    String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

// Panier : un item par ligne (vol ou hôtel), rattaché à l'utilisateur connecté.
model CartItem {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  type       String
  refId      Int // id du Flight ou Hotel référencé
  label      String
  imageUrl   String
  unitPrice  Float
  travelers  Int
  startDate  DateTime
  endDate    DateTime?
  promoCode  String?
  createdAt  DateTime @default(now())
}

model Booking {
  id         Int           @id @default(autoincrement())
  user       User          @relation(fields: [userId], references: [id])
  userId     Int
  reference  String        @unique
  status     String        @default("CONFIRMED")
  totalPrice Float
  createdAt  DateTime      @default(now())
  items      BookingItem[]
}

model BookingItem {
  id        Int      @id @default(autoincrement())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId Int
  type      String
  refId     Int
  label     String
  imageUrl  String
  unitPrice Float
  travelers Int
  startDate DateTime
  endDate   DateTime?
}

// Offres mises en avant, gérées depuis l'espace admin.
model Offer {
  id              Int      @id @default(autoincrement())
  title           String
  description     String
  discountPercent Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
}
